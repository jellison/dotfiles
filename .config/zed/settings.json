// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "sidebar_side": "right",
    "limit_content_width": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15,
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "preview_tabs": {
    "enabled": true,
  },
  "disable_ai": false,
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "ui_font_family": "BerkeleyMono Nerd Font",
  "buffer_font_family": "BerkeleyMono Nerd Font",
  "edit_predictions": {
    "provider": "none",
    "mode": "subtle",
  },
  "languages": {
    "Markdown": {
      "wrap_guides": [100],
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "OpenCode Material Light",
    "dark": "OpenCode Material Dark",
  },
}
