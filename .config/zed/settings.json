// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "helix_mode": false,
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15,
  },
  "ui_font_family": "BerkeleyMono Nerd Font",
  "buffer_font_weight": 400.0,
  "show_whitespaces": "selection",
  "disable_ai": true,
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "preview_tabs": {
    "enabled": false,
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 25.0,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "base_keymap": "VSCode",
  "outline_panel": {
    "indent_size": 25.0,
    "dock": "right",
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "buffer_font_family": "BerkeleyMono Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "OpenCode Material Dark",
  },
  "agent_servers": {
    "claude_custom": {
      "type": "custom",
      "command": "/Users/jellison/.nvm/versions/node/v22.18.0/bin/claude",
      "args": ["--print"],
      "env": {},
    },
  },
  "file_types": {
    "Shell Script": ["*env.rc"],
  },
  "languages": {
    "YAML": {
      "format_on_save": "off",
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "prettier",
      "prettier": {
        "printWidth": 100,
        "proseWrap": "always",
      },
      "remove_trailing_whitespace_on_save": true,
      "preferred_line_length": 100,
      "wrap_guides": [100],
      "show_wrap_guides": true,
    },
  },
}
