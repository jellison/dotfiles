{
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git *)",
      "WebFetch(domain:zed.dev)",
      "WebFetch(domain:www.wpi.edu)",
      "WebFetch(domain:wpi.cleancatalog.net)",
      "WebFetch(domain:ghostty.org)",
      "Skill(update-config)",
      "Edit(/tmp/**)",
      "Edit(/private/tmp/**)",
      "Edit(/var/folders/**)",
      "Edit(/private/var/folders/**)",
      "Bash(go test *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo update)",
      "Bash(make build)",
      "Bash(make install)",
      "Bash(bin/forge *)"
    ],
    "deny": [
      "Edit(/etc/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "/private/tmp",
      "/var/folders",
      "/private/var/folders"
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claudetui hook session-heatmap"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "claudetui hook pre-edit-churn"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/prefer-builtin-tools.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "claudetui hook post-edit-deps"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claudetui statusline --compact",
    "refreshInterval": 10
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoCompactWindow": 400000,
  "fastMode": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "allowedTools": [
    "WebFetch(domain:*)"
  ]
}
