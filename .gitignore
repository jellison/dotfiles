# machine-local overlays (never commit — may contain secrets)
.zshrc.local
.gitconfig.local
*.local
.DS_Store

# Zed runtime (only settings/keymap/themes are tracked)
.config/zed/prompts/
.config/zed/settings_backup.json

# Claude Code — track only the curated common config that stows into ~/.claude.
# Everything else under .claude/ (worktrees, runtime state, generated CLAUDE.md
# and settings.json) stays untracked and machine-local.
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/hooks.json
!.claude/claudeui.json
!.claude/writing-guide.md

# bootstrap machine-local overlay pointer (may name an internal repo) — never commit
bootstrap.local.sh

# opencode — not managed (corporate-flavored provider config + third-party commands)
.config/opencode/
